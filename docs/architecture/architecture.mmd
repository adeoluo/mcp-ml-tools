flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Desktop(["MCP clients<br/>Claude, VS Code, Cursor"]):::edge
        Remote(["HTTP client<br/>POST /mcp"]):::edge
        Guard["Bearer token and<br/>Host header check"]:::control
        Cli(["cli.ts<br/>selects stdio or HTTP"]):::edge
        Transports["Transports<br/>stdio, Streamable HTTP"]:::core
        Cli ~~~ Desktop ~~~ Remote --> Guard --> Transports
    end

    subgraph Core["Core logic"]
        direction TB
        Server["McpServer<br/>error wrapping, timing"]:::core
        Zod["zod input schemas<br/>then tool dispatch"]:::control
        Tokenize["tokenize<br/>byte-level BPE, cost"]:::core
        Bm25["bm25_search<br/>Okapi BM25, snippets"]:::core
        Other["eval_compare, schema<br/>and injection checks"]:::core
        Server --> Zod --> Tokenize ~~~ Bm25 ~~~ Other
    end

    subgraph State["Data and config"]
        direction TB
        Config["config.ts<br/>defaults, file, env"]:::control
        Bpe[("BPE merge table<br/>682-token vocabulary")]:::data
        Prices[("Price table<br/>USD per 1M tokens")]:::data
        Loader["documents.ts<br/>allowlisted loader"]:::control
        Root[("documentRoot<br/>optional, off")]:::data
        Config ~~~ Bpe ~~~ Prices ~~~ Loader --> Root
    end

    subgraph Obs["Outputs and metrics"]
        direction TB
        Results["Tool results<br/>JSON, structuredContent"]:::obs
        Metrics["Metrics<br/>per-tool calls, latency"]:::obs
        Resources["MCP resources<br/>prices, docs, config"]:::obs
        Results ~~~ Metrics ~~~ Resources
    end

    Interfaces -->|JSON-RPC| Core
    Core -.->|reads| State
    State ~~~ Obs
    Core -->|results, timings| Obs
